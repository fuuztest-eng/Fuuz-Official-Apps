                "transform": "(\r\n\t/* buildPoints(topic, tx) -> TimeseriesPoint[] */\r\n\t$buildPoints := function(\r\n\t\t$topic,\r\n\t\t$tx\r\n\t) {\r\n\t\t(\r\n\t\t\t$ts := $tx.time * 1000;\r\n\t\t\t/* unix seconds -> ms, matches precision: 'ms' */\r\n\t\t\t$ingest := $millis() * 1000;\r\n\t\t\t/* TIMESTAMP columns read integer fields as MICROseconds */\r\n\t\t\t$outs := [$tx.out];\r\n\t\t\t/* [] wraps: missing -> empty array, array stays flat */\r\n\t\t\t$append(\r\n\t\t\t\t[\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t\"measurement\": \"btc_tx\",\r\n\t\t\t\t\t\t\"tags\": { \"topic\": $topic },\r\n\t\t\t\t\t\t\"fields\": {\r\n\t\t\t\t\t\t\t\"tx_index\": $tx.tx_index,\r\n\t\t\t\t\t\t\t\"out_count\": $count($outs),\r\n\t\t\t\t\t\t\t/* [$outs.value, 0] drops undefineds and guarantees $sum() gets >=1 number */\r\n\t\t\t\t\t\t\t\"out_value_sats\": $sum([$outs.value, 0]),\r\n\t\t\t\t\t\t\t\"ingest_ts\": $ingest\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\t\"timestamp\": $ts\r\n\t\t\t\t\t}\r\n\t\t\t\t],\r\n\t\t\t\t$outs\r\n\t\t\t\t\t.{\r\n\t\t\t\t\t\t\"measurement\": \"btc_tx_out\",\r\n\t\t\t\t\t\t\"tags\": {\r\n\t\t\t\t\t\t\t\"topic\": $topic,\r\n\t\t\t\t\t\t\t\"out_type\": $exists(type) ? $string(type) : \"\"\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\t/* fields is string|number|boolean — no nulls. $merge omits absent keys\r\n           instead; QuestDB leaves the column NULL. */\r\n\t\t\t\t\t\t\"fields\": $merge([\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\"tx_index\": $tx.tx_index,\r\n\t\t\t\t\t\t\t\t\"n\": n,\r\n\t\t\t\t\t\t\t\t\"value_sats\": value ? value : 0,\r\n\t\t\t\t\t\t\t\t\"spent\": spent ? true : false,\r\n\t\t\t\t\t\t\t\t\"ingest_ts\": $ingest\r\n\t\t\t\t\t\t\t},\r\n\t\t\t\t\t\t\taddr ? { \"addr\": addr } : {},\r\n\t\t\t\t\t\t\tscript ? { \"script\": script } : {}\r\n\t\t\t\t\t\t]),\r\n\t\t\t\t\t\t\"timestamp\": $tsW\r\n\t\t\t\t\t}\r\n\t\t\t)\r\n\t\t)\r\n\t};\r\n\t$params := {\r\n\t\t\"points\": $buildPoints($.value.topic, $.value.parsedValue),\r\n\t\t\"precision\": \"ms\",\r\n\t\t\"flush\": true\r\n\t};\r\n\t$req := {\r\n\t\t\"deviceId\": \"cms50o8tl00k907755kgucq0n\",\r\n\t\t\"functionId\": \"timeseriesWrite\",\r\n\t\t\"request\": $params\r\n\t};\r\n\r\n  $result := $executeDeviceFunction($req);\r\n  $err := $result.error;\r\n  $response := $result.response;\r\n\r\n  {\r\n    \"response\": $result.response,\r\n    \"error\": $result.error\r\n  }\r\n)"
